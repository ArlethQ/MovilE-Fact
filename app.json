{
  "expo": {
    "name": "Numérica Software",
    "slug": "efact-mobile",
    "version": "1.0.2",
    "orientation": "default",
    "icon": "./assets/logo-numerica-square.png",
    "userInterfaceStyle": "light",
    "ios": {
      "infoPlist": {
        "NSFaceIDUsageDescription": "e-fact usa Face ID para proteger el acceso a tu cuenta.",
        "NSSpeechRecognitionUsageDescription": "e-fact necesita reconocimiento de voz para procesar tus órdenes de facturación.",
        "NSMicrophoneUsageDescription": "e-fact necesita el micrófono para recibir tus órdenes de facturación.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "supportsTablet": true,
      "bundleIdentifier": "com.anonymous.efactmobile"
    },
    "android": {
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/logo-numerica-square.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.RECORD_AUDIO",
        "android.permission.INTERNET",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "category": [
            "DEFAULT",
            "BROWSABLE"
          ],
          "data": {
            "scheme": "content",
            "mimeType": "application/pdf"
          }
        },
        {
          "action": "VIEW",
          "category": [
            "DEFAULT",
            "BROWSABLE"
          ],
          "data": {
            "scheme": "file",
            "mimeType": "application/pdf"
          }
        }
      ],
      "package": "com.numericasoftware.efactmobile"
    },
    "plugins": [
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "e-fact usa Face ID para proteger el acceso a tu cuenta."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#0072BD",
          "defaultChannel": "efact-activity"
        }
      ],
      "expo-secure-store",
      [
        "expo-file-system",
        {
          "enableFileSharing": true
        }
      ],
      "expo-font",
      "expo-sharing",
      "expo-status-bar",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "e-fact necesita el micrófono para recibir tus órdenes de facturación.",
          "speechRecognitionPermission": "e-fact necesita reconocimiento de voz para procesar tus órdenes de facturación."
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "web": {
      "favicon": "./assets/logo-numerica.png"
    },
    "extra": {
      "eas": {
        "projectId": "11a8dd21-ff18-44e3-a6a7-00b78d1e7af2"
      }
    },
    "owner": "anahibaee"
  }
}